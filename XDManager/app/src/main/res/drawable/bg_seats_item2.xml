<?xml version="1.0" encoding="utf-8"?><!-- res/drawable/bg_seats_item.xml -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#40FFFFFF">

    <!-- 状态分层（后定义的item会覆盖前面的） -->
    <item>
        <selector>
            <!-- 选中状态 -->
            <item android:state_selected="true">
                <layer-list>
                    <!-- 选中背景色 -->
                    <item>
                        <shape android:shape="rectangle">
                            <gradient
                                android:angle="180"
                                android:endColor="#66282729"
                                android:startColor="#66282729"
                                android:type="linear" />
                            <corners
                                android:bottomLeftRadius="0dp"
                                android:bottomRightRadius="0dp"
                                android:topLeftRadius="2dp"
                                android:topRightRadius="2dp" />
                        </shape>
                    </item>
                    <item>
                        <shape android:shape="rectangle">
                            <gradient
                                android:angle="180"
                                android:endColor="#990BB1C6"
                                android:startColor="#991C1C1D"
                                android:type="linear" />
                            <corners
                                android:bottomLeftRadius="0dp"
                                android:bottomRightRadius="0dp"
                                android:topLeftRadius="2dp"
                                android:topRightRadius="2dp" />
                        </shape>
                    </item>
                </layer-list>
            </item>

            <!-- 默认状态 -->
            <item>
                <shape android:shape="rectangle">
                    <gradient
                        android:angle="180"
                        android:endColor="#F2282729"
                        android:startColor="#e6282729"
                        android:type="linear" />
                    <stroke
                        android:width="0dp"
                        android:color="#2D2D2D" />
                    <corners
                        android:bottomLeftRadius="0dp"
                        android:bottomRightRadius="0dp"
                        android:topLeftRadius="2dp"
                        android:topRightRadius="2dp" />
                </shape>
            </item>
        </selector>
    </item>

    <!-- 保持按压涟漪效果 -->
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <solid android:color="#3D3D3D" />
            <corners
                android:bottomLeftRadius="0dp"
                android:bottomRightRadius="0dp"
                android:topLeftRadius="2dp"
                android:topRightRadius="2dp" />
        </shape>
    </item>
</ripple>