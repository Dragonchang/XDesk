<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <scale android:pivotX="50%" android:pivotY="50%" android:scaleX="0.35" android:scaleY="0.95">
            <shape>
                <gradient android:angle="180" android:centerColor="#9972A0A6 " android:endColor="#9967CBDB " android:startColor="#99777778" android:type="linear" />

                <stroke android:width="0dp" android:color="#ffffff" />
                <corners android:radius="12dp" />
            </shape>

        </scale>
    </item>
    <item>
        <shape>
            <gradient android:angle="180"
                android:centerColor="#4072A0A6 "
                android:endColor="#9967CBDB "
                android:startColor="#1A777778" android:type="linear" />

            <stroke android:width="0dp" android:color="#ffffff" />
            <corners android:radius="12dp" />
        </shape>

    </item>
</selector>