<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <RelativeLayout xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:tools="http://schemas.android.com/tools"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@mipmap/bg"
        tools:context=".MainActivity">

        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="70dp"
            android:layout_marginTop="50dp"
            android:background="#e61C1C1D"
            android:src="@mipmap/logo" />


        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="25dp">

            <LinearLayout
                android:id="@+id/button_container"
                android:layout_width="620dp"
                android:layout_height="110dp"
                android:background="@drawable/bg_tabview"
                android:padding="10dp"
                android:paddingStart="35dp"
                android:paddingEnd="35dp">

                <TextView
                    android:id="@+id/btn_lift"
                    style="@style/ViewSwitchButton"
                    android:text="升降控制"
                    app:drawableTopCompat="@drawable/selector_main_tab1" />

                <TextView
                    android:id="@+id/btn_power"
                    style="@style/ViewSwitchButton"
                    android:text="电源控制"
                    app:drawableTopCompat="@drawable/selector_main_tab2" />

                <TextView
                    android:id="@+id/btn_video"
                    style="@style/ViewSwitchButton"
                    android:text="视频通讯"
                    app:drawableTopCompat="@drawable/selector_main_tab3" />

            </LinearLayout>

            <View
                android:id="@+id/indicator"
                android:layout_width="0dp"
                android:layout_height="3dp"
                android:layout_gravity="bottom"
                android:layout_marginBottom="1dp"
                android:background="@mipmap/ic_tab_select" />
        </FrameLayout>

        <RelativeLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_marginTop="48dp"
            android:layout_marginEnd="48dp">

            <ImageView
                android:id="@+id/main_warn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:background="@mipmap/ic_warn" />

            <TextView
                android:id="@+id/tv_warn_num"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:layout_marginTop="15dp"
                android:layout_toEndOf="@+id/main_warn"
                android:background="@mipmap/ic_circle"
                android:visibility="invisible" />

            <TextView
                android:id="@+id/tv_main_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_toEndOf="@+id/main_warn"
                android:text="09:34"
                android:textColor="#ffffffff"
                android:textSize="40sp" />

            <TextView
                android:id="@+id/tv_main_week"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginStart="13dp"
                android:layout_toEndOf="@+id/tv_main_time"
                android:text="周六"
                android:textColor="#ff828181"
                android:textSize="17sp" />

            <TextView
                android:id="@+id/tv_main_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/tv_main_time"
                android:layout_marginStart="20dp"
                android:layout_toRightOf="@+id/main_warn"
                android:text="2025年03月25日"
                android:textColor="#ff828181"
                android:textSize="17sp" />

        </RelativeLayout>

        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/main_viewpage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginStart="47dp"
            android:layout_marginTop="150dp"
            android:layout_marginEnd="30dp"
            android:layout_marginBottom="20dp" />

        <ImageView
            android:id="@+id/iv_navigation_start"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginStart="8dp"
            android:background="@mipmap/ic_navigation_bg"
            android:src="@drawable/ic_baseline_chevron_right_24" />
    </RelativeLayout>

    <LinearLayout
        android:layout_width="300dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@drawable/bg_navigation"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingTop="100dp"
        android:paddingBottom="100dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:drawablePadding="-120dp"
            android:gravity="center"
            android:text="电源精灵"
            android:textColor="@color/white"
            android:textSize="24sp"
            android:textStyle="bold"
            app:drawableTopCompat="@drawable/ic_baseline_multiline_chart_24" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:drawablePadding="-120dp"
            android:gravity="center"
            android:text="升降课桌"
            android:textColor="@color/white"
            android:textSize="24sp"
            android:textStyle="bold"
            app:drawableTopCompat="@drawable/ic_baseline_table_bar_24" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:drawablePadding="-120dp"
            android:gravity="center"
            android:text="更多产品"
            android:textColor="@color/white"
            android:textSize="24sp"
            android:textStyle="bold"
            app:drawableTopCompat="@drawable/ic_baseline_grid_view_24" />
    </LinearLayout>
</androidx.drawerlayout.widget.DrawerLayout>

