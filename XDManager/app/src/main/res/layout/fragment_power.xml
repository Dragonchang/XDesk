<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/parent_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingStart="100dp"
    android:paddingEnd="100dp"
    tools:context=".fragment.LiftFragment">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="5dp"
        android:layout_marginTop="385dp"
        android:text="2. 选择模式"
        android:textColor="#ffffffff"
        android:textSize="15sp" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="5dp"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="30dp"
            android:text="1.请选择座位"
            android:textColor="#ffffffff"
            android:textSize="15sp" />

        <CheckBox
            android:id="@+id/checkbox_select_all2power"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:button="@drawable/checkbox_selector"
            android:clickable="true"
            android:focusable="true"
            android:paddingStart="8dp"
            android:text="全选"
            android:textColor="#fff"
            android:textSize="15sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="322dp"
        android:layout_marginTop="40dp"
        android:background="@drawable/bg_seats"
        android:orientation="vertical">

        <CheckBox
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="22dp"
            android:background="@drawable/bg_seats_item"
            android:button="@null"
            android:drawableStart="@drawable/checkbox_selector"
            android:drawablePadding="10dp"
            android:gravity="center"
            android:paddingStart="46dp"
            android:paddingTop="4dp"
            android:paddingEnd="46dp"
            android:paddingBottom="4dp"
            android:text="讲台"
            android:textColor="#FFFFFF"
            android:textSize="15sp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyc_power"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:paddingStart="20dp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="422dp"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="183dp"
            android:layout_weight="1"
            android:background="@drawable/shape_btn_bg"
            android:orientation="vertical"
            android:paddingStart="30dp"
            android:paddingEnd="30dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="2"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="学生端电压控制"
                    android:textColor="#fffeffff"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <RelativeLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="20dp"
                    android:layout_weight="1"
                    android:gravity="center_vertical">


                    <TextView
                        android:id="@+id/tv_power_ac"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:clickable="true"
                        android:drawablePadding="8dp"
                        android:focusable="true"
                        android:gravity="center"
                        android:text="交流输出"
                        android:textColor="@color/white"
                        android:textSize="14sp"
                        app:drawableStartCompat="@drawable/selector_acdc" />

                    <TextView
                        android:id="@+id/ac_desc"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_toEndOf="@+id/tv_power_ac"
                        android:gravity="center"
                        android:text="2~24V\n幅度1V"
                        android:textColor="@color/grey"
                        android:textSize="8sp" />

                    <TextView
                        android:id="@+id/tv_power_dc"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="25dp"
                        android:layout_toEndOf="@+id/ac_desc"
                        android:clickable="true"
                        android:drawablePadding="8dp"
                        android:focusable="true"
                        android:gravity="center"
                        android:text="直流输出"
                        android:textColor="@color/white"
                        android:textSize="14sp"
                        app:drawableStartCompat="@drawable/selector_acdc" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_toEndOf="@+id/tv_power_dc"
                        android:gravity="center"
                        android:text="1.5~24V\n幅度0.1V"
                        android:textColor="@color/grey"
                        android:textSize="8sp" />

                    <EditText
                        android:id="@+id/et_power_v"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_below="@+id/tv_power_ac"
                        android:layout_marginTop="15dp"
                        android:layout_marginEnd="80dp"
                        android:background="@drawable/shape_et_bg"
                        android:gravity="center"
                        android:hint="请输入低压电压"
                        android:imeOptions="actionDone"
                        android:inputType="numberDecimal"
                        android:maxLength="4"
                        android:maxLines="1"
                        android:paddingTop="7dp"
                        android:paddingBottom="7dp"
                        android:textColor="@color/white"
                        android:textColorHint="#a3a3a3"
                        android:textSize="14sp" />
                </RelativeLayout>

                <LinearLayout
                    android:id="@+id/ll_lowv_do"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/shape_btn_bg_up"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:paddingStart="25dp"
                    android:paddingTop="16dp"
                    android:paddingEnd="25dp"
                    android:paddingBottom="16dp">

                    <ImageView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:scaleType="center"
                        android:src="@mipmap/ic_do" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="15dp"
                        android:text="低压执行"
                        android:textColor="@color/white"
                        android:textSize="15sp" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="学生端220V通断"
                    android:textColor="#fffeffff"
                    android:textSize="16sp"
                    android:textStyle="bold" />


                <TextView
                    android:id="@+id/tv_power_open220"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="15dp"
                    android:background="@drawable/shape_btn_bg_up"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingStart="35dp"
                    android:paddingTop="8dp"
                    android:paddingEnd="35dp"
                    android:paddingBottom="8dp"
                    android:text="打 开"
                    android:textColor="@color/white"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/tv_power_close220"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="25dp"
                    android:background="@drawable/shape_btn_bg_up"
                    android:clickable="true"
                    android:focusable="true"
                    android:paddingStart="35dp"
                    android:paddingTop="8dp"
                    android:paddingEnd="35dp"
                    android:paddingBottom="8dp"
                    android:text="关 闭"
                    android:textColor="@color/white"
                    android:textSize="15sp" />
            </LinearLayout>


        </LinearLayout>

        <LinearLayout
            android:layout_width="147dp"
            android:layout_height="183dp"
            android:layout_marginStart="45dp"
            android:background="@drawable/shape_btn_bg"
            android:gravity="center"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/ll_power_close"
                android:layout_width="110dp"
                android:layout_height="110dp"
                android:background="@drawable/shape_btn_bg_up"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:scaleType="center"
                    android:src="@mipmap/ic_close" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="一键关机"
                    android:textColor="@color/white"
                    android:textSize="13sp" />
            </LinearLayout>

        </LinearLayout>

        <LinearLayout
            android:layout_width="147dp"
            android:layout_height="183dp"
            android:layout_marginStart="25dp"
            android:background="@drawable/shape_btn_bg"
            android:gravity="center"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/ll_power_lock"
                android:layout_width="110dp"
                android:layout_height="110dp"
                android:background="@drawable/shape_btn_bg_up"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:scaleType="center"
                    android:src="@mipmap/ic_lock_oo" />

                <TextView
                    android:id="@+id/tv_power_lock_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="一键锁屏"
                    android:textColor="@color/white"
                    android:textSize="13sp" />
            </LinearLayout>

        </LinearLayout>
    </LinearLayout>
</FrameLayout>