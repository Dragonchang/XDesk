<resources>

    <style name="Widget.AppTheme.ButtonBar.Fullscreen" parent="">
        <item name="android:background">@color/black_overlay</item>
        <item name="android:buttonBarStyle">?android:attr/buttonBarStyle</item>
    </style>

    <style name="ViewSwitchButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">center</item>
        <item name="android:textSize">16sp</item>
        <item name="android:paddingTop">15dp</item>
        <item name="android:textColor">@drawable/selector_main_tab_text_color</item>
        <item name="android:drawableTint">@drawable/selector_main_tab_text_color</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
    </style>
</resources>